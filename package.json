{
  "name": "luna-kit-stock-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Watches kids-world.dk and csmegastore.no for the Leander Luna conversion kit coming back in stock, and finn.no for second-hand Luna ads",
